// Cloudflare deployment settings for the Mashkhally Zhyanawa website.
// Every page address (/about, /news/…) is served the app, so links and
// bookmarks work and search engines can index each page. Addresses under
// /api/ go to the worker (worker/index.js): the visitor counter and the
// online meetings. Every five minutes the worker sends meeting reminders.
{
  "name": "mashkhall",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VISITS", "class_name": "VisitCounter" },
      { "name": "MEETING_ROOMS", "class_name": "MeetingRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["MeetingRoom"] }
  ],
  // Variables added in the Cloudflare dashboard are kept when the site is deployed.
  "keep_vars": true,
  // Request limits per visitor for the API (see worker/index.js "guard").
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "17001", "simple": { "limit": 600, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "17002", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
